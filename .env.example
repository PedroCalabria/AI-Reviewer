# Copy to .env and fill in. DEPLOYMENT.md describes every variable in full.

# --- Required -----------------------------------------------------------------

# Postgres. Use the pooled connection string if your provider offers one.
DATABASE_URL=
# Direct (non-pooled) connection for `prisma migrate`. Falls back to
# DATABASE_URL. Vercel's DATABASE_URL_UNPOOLED is accepted too.
DIRECT_DATABASE_URL=

# Generate with `npx auth secret`. Rotating it signs everyone out.
AUTH_SECRET=

# --- Strongly recommended -----------------------------------------------------

# Free, no card: https://aistudio.google.com/apikey
# Without it there are no AI drafts and no classifier; template replies and
# keyword escalations still work.
GOOGLE_GENERATIVE_AI_API_KEY=

# `fake` (default) serves the synthetic corpus. `google` throws until Business
# Profile API access is granted — see the README.
REVIEW_PROVIDER=fake

# --- Scheduled sync -----------------------------------------------------------

# Shared secret for POST /api/cron/sync. Must match the GitHub Actions secret.
# Unset means every request is refused.
CRON_SECRET=

# --- Optional -----------------------------------------------------------------

# Google sign-in. Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed when hosting outside Vercel.
# AUTH_URL=
# AUTH_TRUST_HOST=true

# The seeded demo account. Always set DEMO_PASSWORD for a public deployment —
# the default is written in the README.
# DEMO_EMAIL=demo@cornertable.com
# DEMO_PASSWORD=

# The schedule as the UI describes it. Change it if you change the cron.
# SYNC_CADENCE_LABEL=Every six hours, plus whenever you ask

# Gemini pacing. The defaults suit the free tier; a 429 overrides the budgets
# with the real daily limit.
# AI_DAILY_BUDGET_GENERATION=150
# AI_DAILY_BUDGET_CLASSIFIER=150
# AI_MIN_DELAY_MS=6500
# AI_MAX_RETRIES=4
# AI_RETRY_BASE_MS=2000
# AI_RETRY_MAX_MS=32000
# AI_TIMEOUT_MS=30000
# AI_ESCALATION_THRESHOLD=0.4
